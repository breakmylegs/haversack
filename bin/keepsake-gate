#!/bin/sh
# Keepsake strict launch gate (build prompt section 10). Not a binary: a shell script.
#
# Steam starts the game as:  keepsake-gate %command%
# The gate writes a request with a one-off token, waits until Keepsake has
# checked the cloud and answered with the same token, then starts the game.
# If Keepsake does not answer in time, the game starts anyway: the game must
# always stay playable.

gate_dir="${HOME}/homebrew/data/Keepsake/gate"

appid="${SteamAppId:-0}"
if [ "$appid" = "0" ] && [ -n "${SteamGameId:-}" ]; then
    # Non-Steam shortcuts: SteamGameId is (appid << 32) | 0x02000000.
    appid=$(( SteamGameId >> 32 ))
fi

timeout=25
if [ -r "$gate_dir/timeout" ]; then
    read -r configured < "$gate_dir/timeout" || configured=""
    case "$configured" in
        ''|*[!0-9]*) ;;
        *) timeout=$(( configured + 5 )) ;;
    esac
fi

if [ "$appid" != "0" ] && mkdir -p "$gate_dir" 2>/dev/null; then
    token=$(od -An -N8 -tx1 /dev/urandom 2>/dev/null | tr -d ' \n')
    [ -n "$token" ] || token=$(date +%s%N)
    rm -f "$gate_dir/$appid.ready"
    printf '%s' "$token" > "$gate_dir/$appid.waiting"
    waited=0
    limit=$(( timeout * 10 ))
    while [ "$waited" -lt "$limit" ]; do
        if [ -r "$gate_dir/$appid.ready" ] && [ "$(cat "$gate_dir/$appid.ready" 2>/dev/null)" = "$token" ]; then
            break
        fi
        sleep 0.1
        waited=$(( waited + 1 ))
    done
    rm -f "$gate_dir/$appid.waiting" "$gate_dir/$appid.ready"
fi

exec "$@"
